{
  "manifest_version": 3,
  "name": "Gmail AutoMail Merge",
  "version": "1.2",
  "description": "Automate personalized mail merges directly within Gmail using CSV files with background tab execution.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gmail AutoMail Merge"
  },
  "host_permissions": [
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["worker.js"],
      "matches": ["https://mail.google.com/*"]
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
